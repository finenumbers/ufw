# Public URL of the app (used by docker compose for app + auth callbacks).
# In production behind NPM: set to your public HTTPS URL BEFORE docker compose build.
APP_URL=http://localhost:8088
APP_PORT=8088
APP_BIND=127.0.0.1

# Local development: Postgres is exposed on 127.0.0.1 only (see POSTGRES_PORT).
# Production: use docker-compose.prod.yml — it removes all published ports.
EXPOSE_POSTGRES=true
POSTGRES_PORT=5434

# Production behind an EXISTING Nginx Proxy Manager (NPM is NOT installed by this repo).
# Find the network name: docker inspect <npm_container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# Typical values: nginxproxymanager_default, npm_default, proxy
# NPM_NETWORK=nginxproxymanager_default

# Database
POSTGRES_PASSWORD=ufw
DATABASE_URL=postgresql://ufw:ufw@localhost:5434/ufw?schema=public

# Required in production (generate with: openssl rand -base64 32).
# APP_ENCRYPTION_KEY must decode to exactly 32 bytes (base64 length is typically 44 chars).
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# Optional: comma-separated CIDR allowlist for SSH server hosts (empty = block private/metadata IPs only).
# SSH_ALLOWED_CIDRS=

# Production deploy: see .env.production.example and docs/README.md
