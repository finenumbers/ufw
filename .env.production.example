# Production environment template — copy to .env on the server ONLY.
# Never commit .env or this file with real secrets filled in.
#
# Generate a starter file:
#   ./scripts/generate-production-env.sh .env
#
# See docs/README.md and docs/en/deployment/

# Public HTTPS URL (must match NPM Proxy Host). Set at deploy time — not baked into the image.
APP_URL=https://ufw.example.com

# Docker network name used by your existing Nginx Proxy Manager installation.
# docker network ls | grep -i proxy
NPM_NETWORK=nginxproxymanager_default

# GHCR images (replace OWNER with your GitHub username or org, lowercase).
# Build images with GitHub Actions → Release workflow (git tag or dispatch), or pull upstream releases.
IMAGE_TAG=v0.1.0
GHCR_OWNER=your-github-owner
GHCR_APP_IMAGE=ghcr.io/${GHCR_OWNER}/ufw-remote-manager:${IMAGE_TAG}
GHCR_MIGRATE_IMAGE=ghcr.io/${GHCR_OWNER}/ufw-remote-manager-migrate:${IMAGE_TAG}

# Database — use a strong unique password (openssl rand -base64 24).
POSTGRES_PASSWORD=

# Required in production — generate with: openssl rand -base64 32
# APP_ENCRYPTION_KEY must decode to exactly 32 bytes (base64 length is typically 44 chars).
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

# Optional: comma-separated CIDR allowlist for SSH server hosts (empty = block private/metadata IPs only).
# SSH_ALLOWED_CIDRS=
