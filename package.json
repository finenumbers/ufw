{
  "name": "ufw-remote-manager",
  "version": "0.7.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 8088",
    "build": "next build",
    "start": "next start -p 8088",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "auth:generate": "npx @better-auth/cli generate",
    "i18n:check": "npx tsx scripts/i18n-check.ts",
    "docs:check": "npx tsx scripts/docs-check.ts",
    "deadcode:check": "knip --include files,dependencies,exports,types",
    "analyze": "ANALYZE=true npm run build",
    "test": "npx tsx --test src/lib/**/*.test.ts src/lib/*.test.ts src/server/**/*.test.ts",
    "test:coverage": "npx tsx --test --experimental-test-coverage src/lib/**/*.test.ts src/lib/*.test.ts src/server/**/*.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@swc/helpers": "^0.5.17",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "next-intl": "^4.13.0",
    "p-queue": "^8.1.0",
    "papaparse": "^5.5.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^15.3.3",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "knip": "^5.88.1",
    "postcss": "^8.5.4",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "ssh2@1.17.0": true
  }
}
