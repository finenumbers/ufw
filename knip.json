{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/middleware.ts",
    "src/instrumentation.ts",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignore": ["**/*.test.ts"],
  "ignoreDependencies": [
    "pino-pretty",
    "postcss",
    "@tailwindcss/postcss",
    "eslint",
    "eslint-config-next",
    "tailwindcss",
    "tsx",
    "@swc/helpers"
  ]
}
